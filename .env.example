DB_HOST=localhost
DB_PORT=5432
DB_NAME=epicollect_staging
DB_USER=postgres
DB_PASSWORD=postgres
//
NODE_ENV=development
PORT=3001
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_HSTS=false
//
RATE_LIMIT_WINDOW_WS=900000
RATE_LIMIT_API_MAX=200
RATE_LIMIT_WRITE_MAX=60
RATE_LIMIT_TEST_MAX=20
RATE_LIMIT_SYNC_MAX=10
//

# Generar localmente: npm --prefix backend run credentials:key
# Conservar la misma clave; nunca publicarla ni enviarla al frontend.
CREDENTIAL_ENCRYPTION_KEY=

# URLs base exactas autorizadas; agregar aquí la instancia propia usando HTTPS.
EPICOLLECT_API_BASE_URLS=https://five.epicollect.net/api

SYNC_SCHEDULER_ENABLED=false
SYNC_SCHEDULER_POLL_MS=30000
SYNC_REQUEST_INTERVAL_MS=25000
# Archivo local de fuentes de auditoría. Los tokens se referencian por nombre de variable.
# AUDIT_SOURCES_FILE=C:/config/sedecollect/audit-sources.json
